<% layout("/layouts/boilerplate") %>
<body>
    <div id="filters">
      <div class="filter-option">
        <div class="filter">
          <div><i class="fa-solid fa-fire"></i></div> 
           <p>Trending</p>
      </div>
      </div>
      <div class="filter-option">
      <div class="filter">
        <div><i class="fa-solid fa-bed"></i></div> 
      <p>Rooms</p>
      </div>
      </div>
      <div class="filter-option">
      <div class="filter">
        <div><i class="fa-solid fa-mountain-city"></i></div> 
          <p>Iconic Cities</p>
        </div>
        </div>
        <div class="filter-option">
      <div class="filter">
        <div><i class="fa-solid fa-mountain"></i></div> 
          <p>Mountains</p>
      </div>
      </div>
      <div class="filter-option">
      <div class="filter">
        <div><i class="fa-solid fa-fort-awesome"></i></div> 
            <p>Castels</p>
      </div>
      </div>
      <div class="filter-option">
      <div class="filter">
        <div><i class="fa-solid fa-person-swimming"></i></div> 
      <p>Amazing Pools</p>
      </div>
      </div>
      <div class="filter-option">
      <div class="filter">
          <div><i class="fa-solid fa-campground"></i></div>
                <p>Camping</p>
          </div>
          </div>
          <div class="filter-option">
      <div class="filter">
          <div><i class="fa-solid fa-cow"></i></div>
                <p>Farm</p>
      </div>
      </div>
      <div class="filter-option">
      <div class="filter">
          <div><i class="fa-solid fa-snowflake"></i></div>
                <p>Arctic</p>
          </div>
          </div>
          <div class="filter-option">
      <div class="filter">
          <div><i class="fa-solid fa-umbrella-beach"></i></div>
                <p>Beach</p>
      </div>
      </div>
      <div class="filter-option">
      <div class="filter">
          <div><i class="fa-solid fa-sailboat"></i></div>
                <p>Boat</p>
      </div>
      </div>
      <div class="filter-option">
      <div class="filter">
          <div><i class="fa-solid fa-person-snowboarding"></i></div>
                <p>Ski-in/out</p>
          </div>
          </div>
          <div class="filter-option">
      <div class="filter">
          <div><i class="fa-solid fa-building"></i></div>
                <p>Apartment</p>
          </div>
          </div>
          <div class="filter-option">
      <div class="filter">
          <div><i class="fa-solid fa-key"></i></div>
                <p>New</p> 
          </div>
          </div>
       <div class="filter">
          <div><i class="fa-solid fa-tree-city"></i></div>
                <p>Woodlands</p>
          </div> 
       <div class="filter">
          <div><i class="fa-solid fa-water"></i></div>
                <p>Lake</p>
      </div>
      <div class="filter">
          <div><i class="fa-solid fa-house"></i></div>
                <p>Cabins</p>
          </div>
      <div class="filter">
          <div><i class="fa-solid fa-house-chimney-window"></i></div>
                <p>Countryside</p>
          </div> 
        </div>
    <div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1 mt-3">
    <% for(let listing of allListings) { %>
        <a href="/listings/<%=listing._id %>" class="listing-link">
    <div class="card col listing-card">
     <img src="<%= listing.image.url %>" class="card-img-top" alt="listing_image" style="height: 20rem;">
     <div class="card-img-overlay"></div>
     <div class="card-body">
     <p class="card-text">
       <b> <%=listing.title%> </b> <br>
        &#8377; <%=(listing.price || 0).toLocaleString("en-IN") %> /night
        <i class="tax-info"> &nbsp; &nbsp;+18% GST</i>
     </p>
     </div>
    </div> 
    </a>
    <% } %>
    </div>
</body>    
